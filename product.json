{
  "applicationId": "io.taowen.ardesk.debian",
  "name": "Ardesk Debian",
  "versionCode": 1,
  "versionName": "0.1.0",
  "glibcVersion": "2.41",
  "libraryDirectories": [
    "usr/lib/aarch64-linux-gnu",
    "lib/aarch64-linux-gnu",
    "usr/lib"
  ],
  "requiredFiles": [
    "usr/bin/apt-get",
    "var/lib/dpkg/status"
  ],
  "environment": {
    "GCONV_PATH": "${RUNTIME}/usr/lib/aarch64-linux-gnu/gconv",
    "GIO_MODULE_DIR": "${RUNTIME}/usr/lib/aarch64-linux-gnu/gio/modules",
    "LOCPATH": "${RUNTIME}/usr/lib/locale"
  }
}
